{
  "type": "renderableShape",
  "label": "Shape",
  "icon": "mdi:shape-outline",
  "schema": {
    "shapeType": {
      "type": "enum",
      "label": "Shape Type",
      "options": [
        { "label": "Rectangle", "value": "rectangle" },
        { "label": "Circle", "value": "circle" }
      ]      
    },
    "width": {
      "type": "number",
      "label": "Width",
      "dependency": "shapeType-rectangle"
    },
    "height": {
      "type": "number",
      "label": "Height",
      "dependency": "shapeType-rectangle"
    },
    "radius": {
      "type": "number",
      "label": "Radius",
      "dependency": "shapeType-circle"
    },
    "outlineColor": { "type": "color", "label": "Outline Color" },
    "outlineThickness": { "type": "number", "label": "Outline Thickness" }
  },
  "values": {
    "shapeType": "rectangle",
    "width": 30,
    "height": 30,
    "radius": 30,
    "outlineColor": {
      "r": 0,
      "g": 0,
      "b": 0,
      "a": 1
    },
    "outlineThickness": 1
  }
}
