{
  "type": "renderableShape",
  "label": "Shape",
  "icon": "mdi:shape-outline",
  "schema": {
    "type": {
      "type": "enum",
      "label": "Shape Type",
      "options": [
        { "label": "Rectangle", "value": "rectangle" },
        { "label": "Circle", "value": "circle" }
      ]      
    },
    "specs.width": {
      "type": "number",
      "label": "Width",
      "dependency": "type-rectangle"
    },
    "specs.height": {
      "type": "number",
      "label": "Height",
      "dependency": "type-rectangle"
    },
    "specs.radius": {
      "type": "number",
      "label": "Radius",
      "dependency": "type-circle"
    },
    "outlineColor": { "type": "color", "label": "Outline Color" },
    "outlineThickness": { "type": "number", "label": "Outline Thickness" }
  },
    "values": {
      "type": "rectangle",
      "specs.width": 30,
      "specs.height": 30,
      "specs.radius": 30,
      "outlineColor": {
        "r": 0,
        "g": 0,
        "b": 0,
        "a": 1
      },
      "outlineThickness": 1
    }
}
